# =====================================================================
# Kage - local secrets. Copy this file to .env and fill it in.
# .env is gitignored and must NEVER be committed.
# =====================================================================

# --- Provider keys ---------------------------------------------------
# Leave blank until you create the key in each provider's console.
# A blank key just means that provider reports unhealthy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Model gateway (OmniRoute, http://127.0.0.1:8003) ----------------
# The Model screen sends this key to the gateway's /v1 endpoints.
# Create it once in the gateway dashboard: Endpoints -> new key.
GATEWAY_API_KEY=
# GATEWAY_BASE_URL=   # only if the gateway is not on the default 8003
# (OMNIROUTE_* gateway secrets are generated by Start_Inky/run_omniroute.py)
