# =====================================================================
# Kage - local secrets. Copy this file to .env and fill it in.
# .env is gitignored and must NEVER be committed.
# =====================================================================

# --- LiteLLM gateway ---------------------------------------------------
# The admin key for the proxy and its UI. Generate one:
#   python -c "import secrets; print('sk-'+secrets.token_urlsafe(36))"
LITELLM_MASTER_KEY=sk-REPLACE_ME

# Encrypts provider keys added through the UI (stored in Postgres).
# Generate once: python -c "import secrets; print('sk-salt-'+secrets.token_urlsafe(30))"
# DO NOT change it after adding models - stored keys become unreadable.
LITELLM_SALT_KEY=sk-salt-REPLACE_ME

# Kage's own Postgres cluster (Tools/manage_postgres.py). The default
# matches a fresh clone: trust auth, localhost, port 5433, db "litellm".
# A different host (e.g. the phone) overrides this line.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/litellm

# Persist models/keys/teams added through the UI into Postgres.
STORE_MODEL_IN_DB=true

# One gateway worker (laptop and phone), so per-worker limits are fine
# and Redis buys nothing. Hide the "no Redis" banner.
LITELLM_DISABLE_NO_REDIS_WARNING=true

# Login for the LiteLLM admin UI at http://127.0.0.1:8003/ui
UI_USERNAME=kage
UI_PASSWORD=REPLACE_ME

# --- Provider keys ---------------------------------------------------
# Leave blank until you create the key in each provider's console
# (wayfinder T5). A blank key just means that model reports unhealthy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
